# Copy to .env.docker, never to .env.local. No secrets.
COMPOSE_PROJECT_NAME=rj-analyst-local
RJ_BACKEND_CONTEXT=../api-real-jaen
RJ_BACKEND_IMAGE=rj-analyst-backend:local
RJ_FRONTEND_IMAGE=rj-analyst-frontend:local
# Bind to a server interface only deliberately; a host reverse proxy can use loopback.
RJ_FRONTEND_BIND=127.0.0.1
RJ_FRONTEND_PORT=3200
# Create this external volume explicitly. Compose never deletes it on down, even with -v.
RJ_STATE_VOLUME=rj-analyst-local-state
# Existing directory of copied input files/snapshots; never the live SQLite directory.
# Relative to compose.yaml. Create it before starting; mounted read-only in the backend.
RJ_IMPORT_DIR=../deployment/imports

# Access to the whole application (docs/docker.md, «Acceso»), outside code, images and this file:
# - a file with the shared password (12-256 printable ASCII characters), readable by UID 1000 (frontend);
# - a directory with the file session-secret (32-256 characters, random), which signs the 90-day sessions.
#   Rotating it in place revokes every session; changing the password does too.
RJ_ACCESS_PASSWORD_FILE=../deployment/secrets/access-password
RJ_SESSION_SECRET_DIR=../deployment/secrets/session
# Only behind a proxy that overwrites this header with the client's address (e.g. x-real-ip); empty: the attempt
# limit is common to every client, because a header sent by the client itself is never trusted.
RJ_TRUSTED_CLIENT_IP_HEADER=

# Acquisition overlay (compose.acquisition.yaml), only when used. See docs/docker.md, "Adquisición".
# Audited scraper runtime image built from api-real-jaen/docker/scraper; the acquisition build never downloads.
#RJ_SCRAPER_RUNTIME_IMAGE=rj-scraper-runtime:611e436a
#RJ_ACQUISITION_IMAGE=rj-analyst-acquisition:local
# Two external volumes created explicitly: managed browser profile and acquisition jobs/bundles.
#RJ_ACQUISITION_PROFILE_VOLUME=rj-analyst-local-acquisition-profiles
#RJ_ACQUISITION_JOBS_VOLUME=rj-analyst-local-acquisition-jobs
# Existing secret file (32-256 ASCII characters) outside code, images and this file; readable by UID 10001.
#RJ_ACQUISITION_SECRET_FILE=../deployment/secrets/acquisition-token
# 1 allows the real provider (SofaScore). Any other value: the service refuses to start.
#RJ_ACQUISITION_ENABLE_REAL=1
# Update control: one more secret file with the same requirements, readable by UID 10001 (backend) and 1000
# (frontend), only between the Next server and the backend. Updates use the same access session.
#RJ_CONTROL_SECRET_FILE=../deployment/secrets/control-token
